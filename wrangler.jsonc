{
  "name": "broken-night-fb5e",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Işık Işık (Advent): anonymous one-line responses. No database_id on purpose:
  // wrangler creates the database on first deploy and keeps using it afterwards.
  "d1_databases": [{ "binding": "DB", "database_name": "isik-isik" }]
}
